# Automotive Engineering AI Platform - configuration
# Copy to .env and adjust. All values have safe defaults.

# --- LLM (locally hosted via Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=180

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Storage ---
DATA_DIR=./data
VECTORSTORE_DIR=./data/vectorstore
UPLOAD_DIR=./data/uploads
DATABASE_URL=sqlite:///./data/hld.db

# --- Retrieval ---
RETRIEVAL_TOP_K=6
CHUNK_TARGET_CHARS=1200
CHUNK_OVERLAP_CHARS=150

# --- Services ---
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000

# --- Ingestion ---
ENABLE_OCR=true
TESSERACT_CMD=

# --- Access control (pilot: header-based identity) ---
DEFAULT_USER=engineer@local
DEFAULT_ROLE=engineer
